{
  "name": "fold-functions-extension",
  "publisher": "localdev",
  "displayName": "折叠函数工具",
  "description": "在编辑器右键菜单提供折叠/展开当前函数与全部函数的命令",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.50.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:extension.foldCurrentFunction",
    "onCommand:extension.unfoldCurrentFunction",
    "onCommand:extension.foldAllFunctions",
    "onCommand:extension.unfoldAllFunctions"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "typescript": "^4.0.0",
    "@types/vscode": "^1.50.0",
    "vsce": "^2.0.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "extension.foldCurrentFunction",
        "title": "折叠当前函数"
      },
      {
        "command": "extension.unfoldCurrentFunction",
        "title": "展开当前函数"
      },
      {
        "command": "extension.foldAllFunctions",
        "title": "折叠全部函数"
      },
      {
        "command": "extension.unfoldAllFunctions",
        "title": "展开全部函数"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "extension.foldCurrentFunction",
          "when": "editorTextFocus",
          "group": "navigation"
        },
        {
          "command": "extension.unfoldCurrentFunction",
          "when": "editorTextFocus",
          "group": "navigation"
        },
        {
          "command": "extension.foldAllFunctions",
          "when": "editorTextFocus",
          "group": "navigation"
        },
        {
          "command": "extension.unfoldAllFunctions",
          "when": "editorTextFocus",
          "group": "navigation"
        }
      ]
    }
  }
}
